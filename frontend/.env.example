# Frontend — Environment Variables
# Copy to .env.local for local dev, or set in Railway dashboard

# Railway gateway URL — Layer 1 will use this as the default API base
# Set this to your deployed API Gateway URL on Railway
VITE_GATEWAY_URL=https://your-gateway.railway.app

# Default home route — set to /layer1 on Railway so the app opens Layer 1 directly
VITE_HOME=/layer1

# Device/Config gateway (gateway/ service) — หน้า /settings + dashboard ดึงห้อง/อุปกรณ์จากที่นี่
# local dev = http://localhost:8002 ; production = URL ของ gateway บน Railway
VITE_DEVICES_API=http://localhost:8002

# ── ซ่อนข้อมูลก่อนวันที่กำหนด (เช่น วันติดตั้งมิเตอร์) ────────────────────────
# ตั้ง "เฉพาะ Railway service ที่ต้องการซ่อน" — repo เดียวกันแต่คนละ service = คนละ build
# ไม่ตั้ง / ปล่อยว่าง = ไม่ซ่อนอะไรเลย (deployment อื่นไม่กระทบ)
# รูปแบบ YYYY-MM-DD
# ตัวอย่าง: มิเตอร์ 555 (momaycastomeranan-production) ติดตั้ง 22/07/2026
# VITE_DATA_MIN_DATE=2026-07-22

# ── หน่วยกำลังไฟ default ของมิเตอร์ (ใช้เมื่อ device ยังไม่ได้ตั้ง meta.powerUnit) ──
# EM96 / IP Power Meter ส่ง active power เป็น W แต่ backend คิด kWh จากค่านั้นตรงๆ (ถือว่าเป็น kW)
# → dashboard ต้องหาร 1000 ก่อนแสดง ไม่งั้นหน่วยไฟ/ค่าไฟ/โซล่าเซลล์ เกินจริง 1000 เท่า
# 'W'  = หาร 1000 (default — มิเตอร์ที่ใช้อยู่ตอนนี้ทั้งหมด)
# 'kW' = ไม่แปลง (มิเตอร์ที่ส่ง kW มาแล้ว เช่น firmware momay_ESP_pm3250/)
# ตั้งรายมิเตอร์ได้ที่หน้า /settings → อุปกรณ์ "มิเตอร์ไฟ" → powerUnit (ทับค่านี้)
# VITE_METER_POWER_UNIT=W
